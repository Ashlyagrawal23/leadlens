GEMINI_API_KEY=
# Optional. Used only after Gemini fails twice (error, timeout, or invalid JSON).
# If GEMINI_API_KEY is empty, Groq is the only provider.
GROQ_API_KEY=
# Optional. Groq removed llama-3.3-70b-versatile; this default is a current JSON-capable model.
GROQ_MODEL=openai/gpt-oss-120b
# Optional. New keys cannot call gemini-2.0-flash or gemini-2.5-flash.
GEMINI_MODEL=gemini-3.8-flash
